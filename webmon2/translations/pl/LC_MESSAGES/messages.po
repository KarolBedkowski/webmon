#: webmon2/mailer.py:220
msgid "<no title>"
msgstr "<brak tutułu>"

#: webmon2/mailer.py:441
msgid "Errors"
msgstr "Błędy"

#: webmon2/filters/diff.py:27
msgid "Diff with previous content"
msgstr "Porównanie z poprzednią treścią"

#: webmon2/filters/diff.py:29
msgid "Compare current and previous content; show changed elements"
msgstr "Porównuje obecną i poprzednią treść; pokazuje zmienione elementy"

#: webmon2/filters/diff.py:35
msgid "Skip elements when the changes percent is below this level"
msgstr "Pomiń elementy w których zmiana jest poniżej tego poziomu"

#: webmon2/filters/diff.py:42
msgid "Skip elements when the changes lines is below this level"
msgstr "Pomiń elementy gdy liczba zmienionych linii jest poniżej tego poziomu"

#: webmon2/filters/fix_urls.py:25
msgid "Convert relative URLs"
msgstr "Konwersja relatywnych URL-i"

#: webmon2/filters/fix_urls.py:27
msgid "Convert relative URLs to absolute when possible in HTML results."
msgstr ""
"Konwertuje relatywne URL-e do absolutnych jeżeli jest to możliwe w treści"
" HTML."

#: webmon2/filters/grep.py:24
msgid "Filter elements by regular expression"
msgstr "Filtrowanie elementów przez wyrażenie regularne"

#: webmon2/filters/grep.py:26
msgid "Select elements that match or do not match given pattern."
msgstr "Wybiera elementy pasujące lub nie pasujące do podanego wzorca."

#: webmon2/filters/grep.py:31
msgid "Regular expression"
msgstr "Wyrażenie regularne"

#: webmon2/filters/grep.py:36
msgid "Accept items that do not match"
msgstr "Akceptuj elementy nie pasujące"

#: webmon2/filters/history.py:20
msgid "Remove old elements"
msgstr "Usuwanie starych elementów"

#: webmon2/filters/history.py:22
msgid "Remove elements that have been loaded previously by the specified source"
msgstr "Usuwa elementy wcześniej wczytane przez dane źródło"

#: webmon2/filters/html2text.py:25
msgid "Convert HTML to plain text"
msgstr "Konwersja HTML do tekst"

#: webmon2/filters/html2text.py:27
msgid ""
"Attempt to convert HTML content do plain text; remove all formatting and "
"images, etc."
msgstr ""
"Próbuje skonwertować treść HTML do czystego tekstu; usuwa całe "
"formatowanie, obrazy itd"

#: webmon2/filters/html2text.py:32 webmon2/filters/wrap.py:28
msgid "Max line width"
msgstr "Maksymalna długość lini"

#: webmon2/filters/join.py:55
msgid "Join elements together"
msgstr "Łączenie elementów"

#: webmon2/filters/join.py:57
msgid ""
"Combine the content of all elements loaded by a single source into a "
"single element"
msgstr ""
"Łączy treść wszystkich elementów wczytanych przez źródło do jednego elementu"

#: webmon2/filters/score.py:28
msgid "Change score of elements by defined regular expression"
msgstr "Zmiana punktów elementów na podstawie zdefiniowane wyrażenia regularnego"

#: webmon2/filters/score.py:31
msgid "Update the score of an element according to the patterns it matches"
msgstr "Zmienia punków dla elementu na podstawie pasujących wzorców."

#: webmon2/filters/score.py:36
msgid "Regular expressions separated by ';'"
msgstr "Wyrażenia regularne rozdzielone przez ';'"

#: webmon2/filters/score.py:42
msgid "Value added do score when match"
msgstr "Wartość dodawana do punków przy dopasowaniu"

#: webmon2/filters/score.py:48
msgid "Update the score for each pattern match"
msgstr "Aktualizuj punktację dla każdego dopasowania"

#: webmon2/filters/sort.py:20
msgid "Sort elements"
msgstr "Sortowanie elementów"

#: webmon2/filters/sort.py:21
msgid "Sort elements by their titles and contents"
msgstr "Sortuje elementy na podstawie tytułu i zawartości"

#: webmon2/filters/split_re.py:25
msgid "Extract elements by regular expression"
msgstr "Wydobywanie elementów na podstawie wyrażenia regularnego"

#: webmon2/filters/split_re.py:27
msgid ""
"Extract an element from the content using specified regular expression. "
"Expression must include at least one group, and may also contain groups "
"'title' and 'content'."
msgstr ""
"Wydobywa elementy z zawartości na podstawie wyrażenia "
"regularnego. Wyrażenie musi zawierać co najmniej jedną grupę; może także "
"zawierać grupy 'title' i 'content'."

#: webmon2/filters/split_re.py:33 webmon2/filters/split_text.py:48
#: webmon2/filters/split_text.py:79 webmon2/filters/split_text.py:98
msgid "Selector"
msgstr "Wyrażenie"

#: webmon2/filters/split_text.py:41
msgid "Extract elements using a CSS query"
msgstr "Wydobywanie elementów na podstawie wyrażenia CSS"

#: webmon2/filters/split_text.py:43
msgid "Extract elements from the content using specified CSS query"
msgstr "Wydobywa elementy z zawartości na podstawie podanego wyrażenia CSS"

#: webmon2/filters/split_text.py:72
msgid "Extract elements using XPath"
msgstr "Wydobywanie elementów na podstawie xpath "

#: webmon2/filters/split_text.py:74
msgid ""
"Extract elements from the HTML/XML content using specified xpath "
"expression"
msgstr ""
"Wydobywa elementy z treści html/xml na podstawie danego wyrażenia xpath"

#: webmon2/filters/split_text.py:92
msgid "Extract elements with ID"
msgstr "Wydobywanie elementów na podstawie ID"

#: webmon2/filters/split_text.py:94
msgid "Extract an element with specified ID from the HTML content"
msgstr "Wydobywa element o wskazanym ID z zawartości HTML"

#: webmon2/filters/strip.py:20
msgid "Strip white characters"
msgstr "Usuwanie białych znaków"

#: webmon2/filters/strip.py:22
msgid "Trim whitespaces from beginning and end of content"
msgstr "Usuwa białe znaki z początku i końca treści"

#: webmon2/filters/strip.py:36
msgid "Remove duplicate empty lines"
msgstr "Usuwanie zdublowanych pustych linii"

#: webmon2/filters/strip.py:37
msgid "Remove duplicate empty lines from content"
msgstr "Usuwa zdublowane puste linie z zawartości"

#: webmon2/filters/strip.py:52
msgid "Extract the first lines"
msgstr "Wybranie pierwszych linii"

#: webmon2/filters/strip.py:54
msgid "Extract a specified number of top lines from content"
msgstr "Wybiera zdefiniowaną liczbę pierwszych linii z treści"

#: webmon2/filters/strip.py:58
msgid "Maximum number of lines"
msgstr "Maksymalna ilość linii"

#: webmon2/filters/wrap.py:22
msgid "Wrap long lines"
msgstr "Zawijanie długich linii"

#: webmon2/filters/wrap.py:24
msgid ""
"Wrap long content lines to given width; also allow limit total number of "
"lines"
msgstr ""
"Zawiń długie linie do podanej długości; powala ograniczyć także całkowitą"
" liczbę linii"

#: webmon2/filters/wrap.py:30
msgid "Max number of lines"
msgstr "Maksymalna ilość linii"

#: webmon2/sources/dummy.py:27
msgid "Dummy source for development"
msgstr "Sztuczne źródło na potrzeby dewelopmentu"

#: webmon2/sources/dummy.py:55
#, python-format
msgid "dummy entry %(idx)s on %(date)s"
msgstr "sztunczny wpis %(idx)s o %(date)s"

#: webmon2/sources/file_input.py:27
msgid "Data from local file"
msgstr "Dane z lokalnego pliku"

#: webmon2/sources/file_input.py:29
msgid "Source check local, text file defined by \"Full file patch\" setting"
msgstr ""
"Źródło sprawdza lokalny plik tekstowy okreslony przez \"Pełną ścieżka do "
"pliku\""

#: webmon2/sources/file_input.py:33
msgid "Full file patch"
msgstr "Pałna ścieżka do pliku"

